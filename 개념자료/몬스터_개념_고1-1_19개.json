      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 순열"
          },
          "body": "* 서로 다른 n개에서 r개를 순서 있게 나열하는 경우의 수 $_{n}\\mathrm{P}_{r} = \\dfrac{n!}{(n-r)!}$ 이다.",
          "stage3": {
            "mode": "lines",
            "lines": 1
          }
        },
        {
          "type": "table",
          "heading": {
            "1": "2. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "순열",
              "meaning": "순서가 있는 나열"
            },
            {
              "term": "nPr",
              "meaning": "n×(n−1)×…×(n−r+1)"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "3. 예시"
          },
          "body": "* 3P2 = {{6}}\n* 4P2 = {{12}}\n* n!은 1부터 n까지의 {{곱}}",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
