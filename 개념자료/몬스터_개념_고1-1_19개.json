            "outputs": [
              1,
              2,
              5,
              10
            ],
            "width": 100
          },
          "labels": [],
          "labelAdjust": {},
          "stage3": "frame"
        },
        {
          "type": "table",
          "heading": {
            "1": "3. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "나머지정리",
              "meaning": "x−a로 나눈 나머지 = f(a)"
            },
            {
              "term": "인수정리",
              "meaning": "f(a)=0 ↔ x−a가 인수"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "4. 예시"
          },
          "body": "* f(x)=x²+1일 때 x−2로 나눈 나머지는 f(2) = {{5}}\n* f(1)=0이면 (x−1)은 f(x)의 {{인수}}\n* 나머지정리의 나머지는 {{f(a)}}\n* f(x)=x²−3x+2는 f(2)=0이므로 x−2가 {{인수}}",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
