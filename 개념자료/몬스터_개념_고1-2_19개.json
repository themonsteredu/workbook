      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 명제의 역·대우"
          },
          "body": "* p→q에서 역은 q→p, 대우는 ~q→~p.\n* 명제와 그 대우의 참·거짓은 항상 일치한다.",
          "stage3": {
            "mode": "lines",
            "lines": 2
