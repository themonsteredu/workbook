      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 원의 방정식"
          },
          "body": "* 중심 (a,b), 반지름 r인 원은 (x−a)²+(y−b)²=r²이다.\n* x²+y²+Ax+By+C=0 꼴로도 나타낸다.",
          "stage3": {
            "mode": "lines",
            "lines": 2
          }
        },
        {
          "type": "figure",
          "figure_type": "circle_fig",
          "heading": {
