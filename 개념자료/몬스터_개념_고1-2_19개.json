  "concepts": [
    {
      "id": "seed-10-2-1-01",
      "outlineNo": "10-2-1-01",
      "school": "고등학교",
      "grade": "고1",
      "unit_big": "1. 도형의 방정식",
      "unit_mid": "두 점 사이의 거리",
      "keywords": [
        "거리"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 두 점 사이의 거리"
          },
          "body": "* 두 점 (x₁,y₁), (x₂,y₂) 사이의 거리는 √((x₂−x₁)²+(y₂−y₁)²)이다.",
          "stage3": {
            "mode": "lines",
            "lines": 1
          }
        },
        {
          "type": "figure",
          "figure_type": "coord_graph",
          "heading": {
            "1": "2. 좌표평면",
            "3": "2. 그래프로 나타내어 보시오."
          },
          "params": {
            "slope": 1,
            "yIntercept": 0,
            "unit": 40,
            "width": 100
          },
          "labels": [],
          "labelAdjust": {},
          "stage3": "axes_only"
        },
        {
          "type": "table",
          "heading": {
            "1": "3. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "두 점 거리",
              "meaning": "√(Δx²+Δy²)"
            },
            {
              "term": "근거",
              "meaning": "피타고라스 정리"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "4. 예시"
          },
          "body": "* (0,0)과 (3,4) 사이 거리는 {{5}}\n* (1,2)와 (4,6) 사이 거리는 {{5}}\n* 거리² = (x₂−x₁)² + {{(y₂−y₁)²}}",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-10-2-1-02",
      "outlineNo": "10-2-1-02",
      "school": "고등학교",
      "grade": "고1",
      "unit_big": "1. 도형의 방정식",
      "unit_mid": "선분의 내분점과 외분점",
      "keywords": [
        "내분점",
        "외분점"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 내분점·외분점"
          },
          "body": "* 선분 AB를 m:n으로 내분하는 점은 ((nx₁+mx₂)/(m+n), (ny₁+my₂)/(m+n))이다.",
          "stage3": {
            "mode": "lines",
            "lines": 1
          }
        },
        {
          "type": "figure",
          "figure_type": "coord_graph",
          "heading": {
            "1": "2. 좌표평면",
            "3": "2. 그래프로 나타내어 보시오."
          },
          "params": {
            "slope": 1,
            "yIntercept": 0,
            "unit": 40,
            "width": 100
          },
          "labels": [],
          "labelAdjust": {},
          "stage3": "axes_only"
        },
        {
          "type": "table",
          "heading": {
            "1": "3. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "내분점",
              "meaning": "선분을 안에서 나눔"
            },
            {
              "term": "중점",
              "meaning": "1:1 내분점"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "4. 예시"
          },
          "body": "* (0,0)과 (6,0)의 중점은 {{(3, 0)}}\n* (0,0)과 (4,0)을 1:1로 내분하면 {{(2, 0)}}\n* 중점은 m:n = {{1:1}} 내분점",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-10-2-1-03",
      "outlineNo": "10-2-1-03",
      "school": "고등학교",
      "grade": "고1",
      "unit_big": "1. 도형의 방정식",
      "unit_mid": "직선의 방정식",
      "keywords": [
        "직선"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 직선의 방정식"
          },
          "body": "* 기울기 m, y절편 n이면 y=mx+n.\n* 한 점 (x₁,y₁)과 기울기 m이면 y−y₁=m(x−x₁).",
          "stage3": {
            "mode": "lines",
            "lines": 2
          }
        },
        {
          "type": "figure",
          "figure_type": "coord_graph",
          "heading": {
            "1": "2. y = 2x + 1",
            "3": "2. 그래프로 나타내어 보시오."
          },
          "params": {
            "slope": 2,
            "yIntercept": 1,
            "unit": 40,
            "width": 100
          },
          "labels": [],
          "labelAdjust": {},
          "stage3": "axes_only"
        },
        {
          "type": "table",
          "heading": {
            "1": "3. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "직선의 방정식",
              "meaning": "y = mx + n"
            },
            {
              "term": "점·기울기",
              "meaning": "y−y₁=m(x−x₁)"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "4. 예시"
          },
          "body": "* 기울기 2, y절편 1인 직선은 y = {{2x+1}}\n* (0,3) 지나고 기울기 −1이면 y = {{−x+3}}\n* 기울기는 x 증가에 대한 y의 {{증가량}}",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-10-2-1-04",
      "outlineNo": "10-2-1-04",
      "school": "고등학교",
      "grade": "고1",
      "unit_big": "1. 도형의 방정식",
      "unit_mid": "두 직선의 평행과 수직",
      "keywords": [
