    {
      "id": "seed-10-2-2-02",
      "outlineNo": "10-2-2-02",
      "school": "고등학교",
      "grade": "고1",
      "unit_big": "2. 집합과 명제",
      "unit_mid": "집합의 연산",
      "keywords": [
        "교집합",
        "합집합"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 집합의 연산"
          },
          "body": "* 교집합 A∩B, 합집합 A∪B, 차집합 A−B, 여집합 Aᶜ.\n* 드모르간 법칙 등 성질을 이용한다.",
          "stage3": {
            "mode": "lines",
            "lines": 2
          }
        },
        {
          "type": "table",
          "heading": {
            "1": "2. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "교집합",
              "meaning": "A∩B, 공통 원소"
            },
            {
              "term": "합집합",
              "meaning": "A∪B, 전체 원소"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "3. 예시"
          },
          "body": "* A={1,2,3}, B={2,3,4}이면 A∩B = { {{2, 3}} }\n* A∪B = { {{1, 2, 3, 4}} }\n* A−B = { {{1}} }",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-10-2-2-03",
      "outlineNo": "10-2-2-03",
      "school": "고등학교",
      "grade": "고1",
