      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 지수법칙"
          },
          "body": "* aˣaʸ = aˣ⁺ʸ, (aˣ)ʸ = aˣʸ, (ab)ˣ = aˣbˣ (a>0, b>0).\n* 지수가 실수일 때도 같은 법칙이 성립한다.",
          "stage3": {
            "mode": "lines",
            "lines": 2
          }
        },
        {
          "type": "figure",
          "figure_type": "corr_table",
          "heading": {
            "1": "2. 3의 거듭제곱",
            "3": "2. 표를 완성해 보시오."
          },
          "params": {
            "topLabel": "x",
            "botLabel": "3ˣ",
            "inputs": [
              0,
              1,
              2,
              3
            ],
            "outputs": [
              1,
              3,
              9,
              27
            ],
            "width": 100
          },
          "labels": [],
          "labelAdjust": {},
          "stage3": "frame"
        },
        {
          "type": "table",
          "heading": {
            "1": "3. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "aˣaʸ",
              "meaning": "지수의 합 aˣ⁺ʸ"
            },
            {
              "term": "(aˣ)ʸ",
              "meaning": "지수의 곱 aˣʸ"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "4. 예시"
          },
          "body": "* 2³ × 2⁻¹ = {{4}}\n* (3²)³ = 3 ^ {{6}}\n* 5⁰ = {{1}}",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-11-1-1-04",
      "outlineNo": "11-1-1-04",
      "school": "고등학교",
      "grade": "고2",
      "unit_big": "1. 지수함수와 로그함수",
      "unit_mid": "지수함수와 그래프",
      "keywords": [
        "지수함수",
        "점근선",
