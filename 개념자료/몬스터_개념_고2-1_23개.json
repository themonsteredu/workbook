          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "지수방정식",
              "meaning": "지수에 미지수가 있는 방정식"
            },
            {
              "term": "밑 통일",
              "meaning": "같은 밑으로 고쳐 비교"
            }
          ]
