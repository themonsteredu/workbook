            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-12-2-2-08",
      "outlineNo": "12-2-2-08",
      "school": "고등학교",
      "grade": "고3",
      "unit_big": "2. 미분법",
      "unit_mid": "매개변수·음함수의 미분",
      "keywords": [
        "매개변수",
        "음함수"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 매개변수·음함수 미분"
          },
          "body": "* x=f(t), y=g(t)이면 $\\dfrac{dy}{dx}$ = $\\dfrac{\\;\\frac{dy}{dt}\\;}{\\;\\frac{dx}{dt}\\;}$ 이다.\n* x²+y²=1처럼 음함수 꼴은 양변을 x로 미분해 y′를 구한다.",
          "stage3": {
            "mode": "lines",
            "lines": 2
          }
        },
        {
          "type": "figure",
          "figure_type": "circle_fig",
          "heading": {
            "1": "2. 원 x²+y²=r² (음함수)",
            "3": "2. 원을 그려 보시오."
          },
          "params": {
            "showRadius": true,
            "showDiameter": false,
            "showCircumference": false,
            "width": 70
          },
          "labels": [
            {
              "key": "jungsim",
              "text": "중심",
              "blank": false
            },
