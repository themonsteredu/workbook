          },
          "params": {
            "curve": "exp",
            "a": 1,
            "p": 0,
            "q": 0,
            "unit": 40,
            "slope": 1,
            "yIntercept": 0,
            "width": 100,
            "base": 4
          },
          "labels": [],
          "labelAdjust": {},
          "stage3": "axes_only"
        },
        {
          "type": "table",
          "heading": {
            "1": "3. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "연쇄법칙",
              "meaning": "겉미분 × 속미분"
            },
            {
              "term": "적용",
              "meaning": "겹쳐진 함수의 미분"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "4. 예시"
          },
          "body": "* (e²ˣ)′ = e²ˣ × {{2}}\n* {(x²+1)³}′ = 3(x²+1)² × {{2x}}\n* (sin 3x)′ = 3 {{cos 3x}}",
