      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. y=ax² 그래프"
          },
          "body": "* y=ax²의 그래프는 원점을 꼭짓점으로 하는 {{포물선}}이다.\n* a>0이면 아래로 볼록, a<0이면 위로 볼록이다.",
          "stage3": {
            "mode": "lines",
            "lines": 2
          }
        },
        {
          "type": "figure",
          "figure_type": "coord_graph",
          "heading": {
            "1": "2. 포물선 (y = x²)",
            "3": "2. 그래프로 나타내어 보시오."
          },
          "params": {
            "curve": "parabola",
            "a": 1,
            "p": 0,
            "q": 0,
            "unit": 30,
            "slope": 1,
            "yIntercept": 0,
            "width": 100
          },
          "labels": [],
          "labelAdjust": {},
          "stage3": "axes_only"
        },
        {
          "type": "table",
          "heading": {
            "1": "3. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "포물선",
              "meaning": "이차함수의 그래프 모양"
            },
            {
              "term": "꼭짓점",
              "meaning": "원점 (0, 0)"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "4. 예시"
          },
          "body": "* y=x²의 꼭짓점은 {{(0, 0)}}\n* a>0이면 {{아래로 볼록}}\n* |a|가 클수록 폭이 {{좁아진다}}",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-9-2-1-03",
      "outlineNo": "9-2-1-03",
      "school": "중학교",
      "grade": "중3",
      "unit_big": "1. 이차함수와 그래프",
