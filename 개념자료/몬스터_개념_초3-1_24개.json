          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "받아내림",
              "meaning": "뺄 수 없을 때 윗자리에서 10을 빌려 오는 것"
            },
            {
              "term": "일의 자리",
              "meaning": "맨 오른쪽 자리, 계산을 시작하는 자리"
            }
          ]
        },
        {
          "type": "text",
