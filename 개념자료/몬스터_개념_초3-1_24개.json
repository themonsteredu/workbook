              "key": "caption",
              "text": "분수",
              "blank": false
            }
          ],
          "labelAdjust": {},
          "stage3": "frame"
        }
      ]
    },
    {
      "id": "seed-3-1-10",
      "outlineNo": "3-1-10",
      "school": "초등학교",
      "grade": "3학년",
      "unit_big": "나눗셈",
      "unit_mid": "몫, 나눗셈식 읽고 쓰기",
      "keywords": [
        "나눗셈",
        "몫"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 나눗셈식과 몫"
          },
          "body": "* 12 ÷ 4 = 3 에서 나눗셈의 결과인 3을 {{몫}}이라고 한다.\n* 12 ÷ 4 = 3 은 “12 나누기 4는 3과 같다”라고 읽는다.",
          "stage3": {
            "mode": "lines",
            "lines": 2
          }
        },
        {
          "type": "table",
          "heading": {
            "3": "2. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "{{몫}}",
              "meaning": "나눗셈을 하여 나온 결과"
            }
          ]
        }
      ]
    },
    {
      "id": "seed-3-1-11",
      "outlineNo": "3-1-11",
      "school": "초등학교",
      "grade": "3학년",
      "unit_big": "나눗셈",
      "unit_mid": "곱셈과 나눗셈의 관계",
      "keywords": [
        "곱셈",
        "나눗셈",
        "관계"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 곱셈과 나눗셈의 관계"
          },
          "body": "* 하나의 곱셈식으로 두 개의 나눗셈식을 만들 수 있다.\n* 예: 4 × 3 = 12 이면 12 ÷ 4 = {{3}}, 12 ÷ 3 = {{4}} 이다.\n* 나눗셈의 몫은 곱셈으로 확인할 수 있다.",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-3-1-12",
      "outlineNo": "3-1-12",
      "school": "초등학교",
      "grade": "3학년",
      "unit_big": "곱셈",
      "unit_mid": "(두 자리 수)×(한 자리 수)의 원리 (올림 없음)",
      "keywords": [
        "곱셈",
        "자리"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 올림이 없는 곱셈"
          },
          "body": "* 두 자리 수를 {{십의 자리}}와 일의 자리로 나누어 각각 곱한 뒤 더한다.\n* 예: 23 × 2 는 20 × 2 = 40, 3 × 2 = 6 이므로 답은 {{46}} 이다.",
          "stage3": {
            "mode": "lines",
            "lines": 2
          }
        }
      ]
    },
    {
      "id": "seed-3-1-13",
      "outlineNo": "3-1-13",
      "school": "초등학교",
      "grade": "3학년",
      "unit_big": "곱셈",
      "unit_mid": "(두 자리 수)×(한 자리 수)의 원리 (올림 있음)",
      "keywords": [
        "곱셈",
        "올림"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 올림이 있는 곱셈"
          },
          "body": "* 일의 자리끼리 곱한 값이 10이거나 넘으면 십의 자리로 {{올림}}한다.\n* 올림한 수는 십의 자리 곱에 더해 준다.\n* 예: 27 × 3 은 7 × 3 = 21 에서 2를 올림한다.",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-3-1-14",
      "outlineNo": "3-1-14",
      "school": "초등학교",
      "grade": "3학년",
      "unit_big": "길이와 시간",
      "unit_mid": "1mm, 1cm와 mm의 관계",
      "keywords": [
        "mm",
        "cm",
        "길이"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 밀리미터(mm)"
          },
          "body": "* 1cm를 똑같이 10칸으로 나눈 것 중 한 칸의 길이가 {{1mm}}이다.\n* 1cm = {{10}}mm 이다.\n* 밀리미터는 자에서 작은 눈금 한 칸의 길이이다.",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-3-1-15",
      "outlineNo": "3-1-15",
      "school": "초등학교",
      "grade": "3학년",
      "unit_big": "길이와 시간",
      "unit_mid": "1km, km와 m의 관계",
      "keywords": [
        "km",
        "m",
        "길이"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 킬로미터(km)"
          },
          "body": "* 1000m를 {{1km}}라 하고 “1킬로미터”라고 읽는다.\n* 1km = {{1000}}m 이다.\n* 킬로미터는 먼 거리를 나타낼 때 쓴다.",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-3-1-16",
      "outlineNo": "3-1-16",
      "school": "초등학교",
      "grade": "3학년",
      "unit_big": "길이와 시간",
      "unit_mid": "1초, 분과 초의 관계",
      "keywords": [
        "초",
        "분",
        "시간"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 초와 분의 관계"
          },
          "body": "* 시계의 초바늘이 작은 눈금 한 칸을 갈 때 걸리는 시간이 {{1초}}이다.\n* 1분 = {{60}}초 이다.\n* 초바늘이 시계를 한 바퀴 돌면 1분이 지난 것이다.",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
