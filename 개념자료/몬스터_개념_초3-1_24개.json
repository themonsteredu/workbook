          "rows": [
            {
              "term": "{{꼭짓점}}",
              "meaning": "각을 이루는 두 반직선이 만나는 점"
            },
            {
              "term": "{{변}}",
              "meaning": "각을 이루는 두 반직선"
            }
          ]
        }
      ]
    },
    {
      "id": "seed-3-1-06",
      "outlineNo": "3-1-06",
      "school": "초등학교",
      "grade": "3학년",
      "unit_big": "평면도형",
