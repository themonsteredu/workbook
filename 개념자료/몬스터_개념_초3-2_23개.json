          "params": {
            "op": "÷",
            "operands": [
              17,
              5
            ],
            "width": 55,
            "showSteps": true
          },
          "labels": [],
          "labelAdjust": {},
          "stage3": "answer_blank"
        },
        {
          "type": "table",
          "heading": {
            "1": "3. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "나머지",
              "meaning": "나누어떨어지지 않고 남는 수"
            },
            {
              "term": "나누어떨어진다",
              "meaning": "나머지가 0인 경우"
            }
