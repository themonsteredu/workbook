  "concepts": [
    {
      "id": "seed-4-1-01",
      "outlineNo": "4-1-01",
      "school": "초등학교",
      "grade": "4학년",
      "unit_big": "큰 수",
      "unit_mid": "만, 다섯 자리 수",
      "keywords": [
        "큰 수",
        "만",
        "자리"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 만과 다섯 자리 수"
          },
          "body": "* 1000이 10개인 수를 10000 또는 1만이라 쓰고 {{만}}이라고 읽는다.\n* 다섯 자리 수는 만의 자리부터 차례로 읽는다.",
          "stage3": {
            "mode": "lines",
            "lines": 2
          }
        },
        {
          "type": "table",
          "heading": {
            "1": "2. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "만",
              "meaning": "1000이 10개인 수, 10000"
            },
            {
              "term": "자리",
              "meaning": "일·십·백·천·만의 자리"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "3. 예시"
          },
          "body": "* 10000은 1000이 {{10}}개인 수이다.\n* 27000 = 2만 {{7000}}.\n* 5만은 {{50000}} 이다.",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-4-1-02",
      "outlineNo": "4-1-02",
      "school": "초등학교",
      "grade": "4학년",
      "unit_big": "큰 수",
      "unit_mid": "십만, 백만, 천만",
      "keywords": [
        "큰 수",
        "십만",
        "천만"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 십만·백만·천만"
          },
          "body": "* 10000이 10개면 {{십만}}, 100개면 {{백만}}, 1000개면 {{천만}}이다.\n* 네 자리마다 자리가 커진다.",
          "stage3": {
            "mode": "lines",
            "lines": 2
          }
        },
        {
          "type": "table",
          "heading": {
            "1": "2. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "십만",
              "meaning": "10000이 10개 (100000)"
            },
            {
              "term": "백만",
              "meaning": "10000이 100개"
            },
            {
              "term": "천만",
              "meaning": "10000이 1000개"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "3. 예시"
          },
          "body": "* 100000은 만이 {{10}}개.\n* 3400000 = {{340}}만.\n* 천만은 1 다음에 0이 {{7}}개인 수이다.",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
      "id": "seed-4-1-03",
      "outlineNo": "4-1-03",
      "school": "초등학교",
      "grade": "4학년",
      "unit_big": "큰 수",
      "unit_mid": "억과 조",
      "keywords": [
        "큰 수",
        "억",
        "조"
      ],
      "blocks": [
        {
          "type": "text",
          "heading": {
            "1": "1. 억과 조"
          },
          "body": "* 1000만이 10개인 수를 {{억}}(1억)이라고 한다.\n* 1000억이 10개인 수를 {{조}}라고 한다.\n* 큰 수는 네 자리씩 끊어 읽는다.",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        },
        {
          "type": "table",
          "heading": {
            "1": "2. 용어 정리"
          },
          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "억",
              "meaning": "1000만이 10개, 1 다음 0이 8개"
            },
            {
              "term": "조",
              "meaning": "1000억이 10개, 1 다음 0이 12개"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "3. 예시"
          },
          "body": "* 1억은 1 다음에 0이 {{8}}개.\n* 1조는 1 다음에 0이 {{12}}개.\n* 억, 조는 네 자리씩 끊어 {{읽는다}}.",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
