          "columns": [
            "용어",
            "의미"
          ],
          "rows": [
            {
              "term": "자릿값",
              "meaning": "숫자가 그 자리에서 나타내는 값"
            },
            {
              "term": "뛰어 세기",
              "meaning": "일정한 수만큼 커지게(작아지게) 세기"
            }
          ]
        },
        {
          "type": "text",
          "heading": {
            "1": "4. 예시"
          },
          "body": "* 5273에서 2의 자릿값은 {{200}}.\n* 3000부터 1000씩 뛰면 3000, 4000, {{5000}}, 6000.\n* 4700에서 100씩 3번 뛰면 {{5000}}.",
          "stage3": {
            "mode": "lines",
            "lines": 3
          }
        }
      ]
    },
    {
